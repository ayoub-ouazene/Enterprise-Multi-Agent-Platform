# ─── Secrets & environment files ────────────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
frontend/.env

# ─── Temporary / debug scripts at repo root ────────────────────────────────
tmp_*.py
tmp_*.js
tmp_*.ts

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ─── Node / Frontend ────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Uploaded files (keep the folder via .gitkeep, ignore contents) ─────────
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Editor / IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS files ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Alembic / DB local artifacts ──────────────────────────────────────────
*.sqlite
*.sqlite3
backend/alembic/versions/__pycache__/
