# ─── Secrets & environment files ────────────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
frontend/.env

# ─── Temporary / debug scripts at repo root ────────────────────────────────
tmp_*.py
tmp_*.js
tmp_*.ts

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ─── Node / Frontend ────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Uploaded files (keep the folder via .gitkeep, ignore contents) ─────────
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Editor / IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS files ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Windows reserved device names (stray files from `> NUL` redirects) ────
# On Windows, NUL is a reserved device name. In Git Bash / MSYS, a redirect
# like `command > NUL` can create a literal file named "NUL" instead of
# discarding output. Git cannot index such files and `git add .` fails with
# "unable to index file 'NUL'". Ignore them so they never block staging.
NUL
nul
backend/NUL
backend/nul

# ─── Playwright CLI debug snapshots ────────────────────────────────────────
.playwright-cli/
frontend/.playwright-cli/

# ─── Local backup / scratch directories ─────────────────────────────────────
backend/.bak/

# ─── Local debug screenshots & logs at repo root ───────────────────────────
/*.png
/error.txt
/temp_*.png

# ─── Alembic / DB local artifacts ──────────────────────────────────────────
*.sqlite
*.sqlite3
backend/alembic/versions/__pycache__/
